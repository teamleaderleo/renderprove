ARG PLAYWRIGHT_VERSION=1.56.1
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble

ENV CI=1 \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/tmp/renderprove-home

WORKDIR /opt/renderprove

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY bin ./bin
COPY src ./src
COPY schema ./schema
COPY scripts/worker-identity.mjs ./scripts/worker-identity.mjs
COPY README.md SECURITY.md LICENSE ./

ENTRYPOINT ["node", "/opt/renderprove/bin/renderprove.mjs"]
CMD ["help"]
