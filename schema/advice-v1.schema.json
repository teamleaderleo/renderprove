{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/teamleaderleo/renderprove/main/schema/advice-v1.schema.json",
  "title": "Renderprove advisory result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "authoritative",
    "provider",
    "model",
    "startedAt",
    "finishedAt",
    "input",
    "verdict",
    "summary",
    "findings",
    "strengths",
    "omissions",
    "usage",
    "providerRequestId",
    "generation"
  ],
  "properties": {
    "version": { "const": 1 },
    "authoritative": { "const": false },
    "provider": { "const": "cloudflare-workers-ai" },
    "model": { "type": "string", "minLength": 1, "maxLength": 240 },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "input": { "$ref": "#/$defs/input" },
    "verdict": { "enum": ["clear", "concern", "unknown"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/finding" }
    },
    "strengths": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "omissions": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "usage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt_tokens": { "type": "number", "minimum": 0 },
            "completion_tokens": { "type": "number", "minimum": 0 },
            "total_tokens": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "providerRequestId": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 500 }
      ]
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "seed", "maxCompletionTokens", "reasoningEffort"],
      "properties": {
        "temperature": { "const": 0 },
        "seed": { "type": "integer" },
        "maxCompletionTokens": { "type": "integer", "minimum": 1 },
        "reasoningEffort": { "const": "low" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "project", "manifest", "receipt", "sha256", "summary", "files", "omissions"],
      "properties": {
        "version": { "const": 1 },
        "project": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "receipt": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "sha256": { "$ref": "#/$defs/digest" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "bytes", "redactions", "omissions"],
          "properties": {
            "files": { "type": "integer", "minimum": 1 },
            "bytes": { "type": "integer", "minimum": 0 },
            "redactions": { "type": "integer", "minimum": 0 },
            "omissions": { "type": "integer", "minimum": 0 }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256", "redactions"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "$ref": "#/$defs/digest" },
              "redactions": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "title", "evidence", "recommendation"],
      "properties": {
        "severity": { "enum": ["info", "warning", "high"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "detail"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 500 },
              "detail": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "recommendation": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
