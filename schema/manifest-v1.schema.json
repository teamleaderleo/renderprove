{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/teamleaderleo/renderprove/main/schema/manifest-v1.schema.json",
  "title": "Renderprove manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "review"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "port"],
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cwd": { "type": "string", "minLength": 1 },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "readyPath": { "type": "string", "pattern": "^/(?![/\\\\])" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "shutdownMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl"],
      "properties": { "baseUrl": { "type": "string", "format": "uri", "pattern": "^https?://[^/?#]+/?$" } }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes"],
      "properties": {
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "string", "pattern": "^/(?![/\\\\])" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": { "type": "string", "pattern": "^/(?![/\\\\])" },
                  "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
                  "waitForMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
                  "fullPage": { "type": "boolean" }
                }
              }
            ]
          }
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "enum": ["desktop", "mobile", "tablet"] },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "width", "height"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
                  "width": { "type": "integer", "minimum": 240, "maximum": 7680 },
                  "height": { "type": "integer", "minimum": 240, "maximum": 7680 },
                  "deviceScaleFactor": { "type": "integer", "minimum": 1, "maximum": 3 }
                }
              }
            ]
          }
        },
        "failOn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "consoleError": { "type": "boolean" },
            "pageError": { "type": "boolean" },
            "requestFailure": { "type": "boolean" },
            "httpError": { "type": "boolean" }
          }
        },
        "outputDir": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "navigationTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
      }
    }
  },
  "oneOf": [
    { "required": ["runtime"], "not": { "required": ["target"] } },
    { "required": ["target"], "not": { "required": ["runtime"] } }
  ]
}
